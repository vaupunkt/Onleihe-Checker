    "smoke": "python3 tools/smoke_api.py",
    "libraries": "python3 tools/build_libraries.py"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "web-ext": "^8.3.0"
  },
  "license": "MIT"
}
