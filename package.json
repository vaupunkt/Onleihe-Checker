{
  "name": "onleihe-checker",
  "version": "2.0.0",
  "private": true,
  "description": "Browser-Erweiterung, die die Verfügbarkeit von Büchern in der Onleihe prüft",
  "scripts": {
    "build": "tools/build.sh",
    "test": "node --test tools/test_shared.mjs tools/test_content.mjs",
