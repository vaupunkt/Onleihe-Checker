{
  "manifest_version": 3,
  "name": "Onleihe Checker",
  "version": "1.3",
  "description": "Eingestellt: Die Erweiterung prüft keine Titel mehr und kann deinstalliert werden.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Veliko Kardziev",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "sunset.html",
    "default_title": "Onleihe Checker – eingestellt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
